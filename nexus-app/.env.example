# ---------------------------------------------------------------
# Copy file này thành `.env.local` rồi điền giá trị thật.
# KHÔNG commit `.env.local` — nó đã nằm trong .gitignore.
# ---------------------------------------------------------------

# Supabase — lấy ở Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL gốc của site, dùng để dựng redirect cho Google OAuth.
# Local để http://localhost:3000, production đổi thành domain thật.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider — chưa dùng tới. Sẽ cần khi nối /api/generate.
# Chỉ để ở server, tuyệt đối không thêm tiền tố NEXT_PUBLIC_.
FAL_KEY=
REPLICATE_API_TOKEN=
