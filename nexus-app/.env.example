# ---------------------------------------------------------------
# Copy file này thành `.env.local` rồi điền giá trị thật.
# KHÔNG commit `.env.local` — nó đã nằm trong .gitignore.
# ---------------------------------------------------------------

# Supabase — lấy ở Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL gốc của site, dùng để dựng redirect cho Google OAuth.
# Local để http://localhost:3000, production đổi thành domain thật.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fal.ai. Chỉ để ở server, tuyệt đối không thêm tiền tố NEXT_PUBLIC_ —
# thêm vào là khoá lộ ra trình duyệt, ai cũng tiêu tiền của bạn được.
FAL_KEY=

# Đường dẫn model. Xem danh sách ở fal.ai/models, chép phần sau fal.run/
FAL_MODEL=fal-ai/ip-adapter-face-id

# Tên trường nhận ảnh gốc. MỖI MODEL MỘT KHÁC — mở tab API của model trên
# fal.ai để xem đúng tên. Gọi sai thì Fal.ai sẽ báo lại tên đúng trong lỗi.
FAL_IMAGE_FIELD=image_url

# Dự phòng, chưa dùng tới
REPLICATE_API_TOKEN=

# Gộp mọi ảnh tham chiếu thành MỘT MẢNG trong trường ghi ở FAL_IMAGE_FIELD.
# Bật khi model nhận ảnh dạng mảng thay vì mỗi loại một trường riêng.
#
# Ví dụ cho Nano Banana — model đọc được ảnh mẫu, hợp việc sao chép phong cách:
#   FAL_MODEL=fal-ai/nano-banana-2/edit
#   FAL_IMAGE_FIELD=image_urls
#   FAL_IMAGE_ARRAY=1
FAL_IMAGE_ARRAY=

# Danh sách model được phép chọn trên giao diện, ngăn bằng dấu phẩy.
FAL_MODELS=

# Đặt 1 để chạy chế độ thử: không gọi Fal.ai, không tốn tiền.
NEXUS_DEMO=
